import java.util.Scanner;
class Solution{
    public static void main(String[]args){
    Scanner as=new Scanner(System.in);
    int n=as.nextInt();
    int[] arr=new int[n];
    for(int i=0;i<n;i++){
       arr[i]=as.nextInt();
        }
        int min=arr[0];
        for(int i=1;i<n;i++){
            if(arr[i]<min){
                min=arr[i];
            }
        }
        System.out.println(min);
    }
}
