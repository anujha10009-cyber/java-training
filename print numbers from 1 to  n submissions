import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();  // Just read one integer N

        for (int i = 1; i <= N; i++) {
            System.out.print(i);
            if (i != N) {
                System.out.print(" ");
            }
        }
        System.out.println();
    }
}
