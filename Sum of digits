import java.util.Scanner;
class Main{
    public static void main(String[]args){
        Scanner as=new Scanner(System.in);
        int n;
        n=as.nextInt();
        int product=1;
        
        int org=n;
        
        while(n>0){
        int s  = n % 10;
        product*= s;
        n /= 10;
        }
        System.out.println(" Product Of Digits of : " + org + "is : "+ product);
        }
    }
