import java.util.Scanner;

class Main {
    public static void main(String[] args) {
        Scanner as = new Scanner(System.in);

        System.out.print("Enter first number: ");
        int a = as.nextInt();

        System.out.print("Enter second number: ");
        int b = as.nextInt();

        int count = b - a - 1;

        System.out.println("Count: " + count);
    }
}
