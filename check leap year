import java.util.Scanner;
 class Solution {
    public static void main(String[]args)
    {
    int a;
    Scanner as=new Scanner(System.in);
    a=as.nextInt();
    if(a%4==0&&a%100!=0||a%400==0)
    {
        System.out.println("Leap Year");
    }
      else
    {
        System.out.println("Not Leap Year");
    }
  }
}
