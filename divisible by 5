import java.util.Scanner;
class Main{
    public static void main(String[]args){
        Scanner as=new Scanner(System.in);
        int n;
        n=as.nextInt();
        int sum = 0;
          for(int i=1;i<=n;i++)
          {
           if(n % 5==0)
           sum=sum + i;
           }
      System.out.println(sum);
   }
}
